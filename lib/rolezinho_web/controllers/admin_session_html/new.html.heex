<Layouts.app flash={@flash} current_admin?={false} tabs?={false}>
  <div class="max-w-sm mx-auto mt-10">
    <h1 class="text-2xl font-bold mb-6 tracking-tight">Login do admin</h1>

    <.form
      :let={_f}
      for={%{}}
      as={:session}
      action={~p"/admin/login"}
      id="admin-login-form"
      class="space-y-4"
    >
      <.input
        type="password"
        name="password"
        id="admin-password"
        label="Senha"
        value=""
        required
        autofocus
      />

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors cursor-pointer disabled:opacity-50 disabled:pointer-events-none px-4 py-2 text-sm bg-primary text-primary-content hover:bg-primary/90 w-full"
      >
        Entrar
      </button>
    </.form>

    <p :if={@error} class="mt-4 text-sm text-error">{@error}</p>
  </div>
</Layouts.app>
