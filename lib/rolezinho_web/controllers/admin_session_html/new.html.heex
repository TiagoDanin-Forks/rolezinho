<Layouts.app flash={@flash} current_admin?={false}>
  <div class="max-w-sm mx-auto mt-10">
    <h1 class="text-2xl font-bold mb-6 tracking-tight">Login do admin</h1>

    <.form
      :let={_f}
      for={%{}}
      as={:session}
      action={~p"/admin/login"}
      id="admin-login-form"
      class="space-y-4"
    >
      <.input
        type="password"
        name="password"
        id="admin-password"
        label="Senha"
        value=""
        required
        autofocus
      />

      <button type="submit" class="btn btn-primary w-full">
        Entrar
      </button>
    </.form>

    <p :if={@error} class="mt-4 text-sm text-error">{@error}</p>
  </div>
</Layouts.app>
