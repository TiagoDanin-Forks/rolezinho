# =============================================================
# Claude Code
# -------------------------------------------------------------
# Ignore everything inside .claude/ by default, then whitelist
# the files that belong to the project (shared with the team).
# =============================================================
# Re-include .claude/ (the user's global gitignore excludes the
# whole directory, which would block the whitelists below)
!.claude/
.claude/*
!.claude/settings.json
!.claude/rules/
!.claude/skills/
!.claude/agents/
!.claude/commands/

# User-local settings and personal overrides (never versioned)
.claude/settings.local.json
.claude/*.local.json
CLAUDE.local.md

# CLAUDE.md is intentionally NOT versioned: AGENTS.md is this project's
# single entry point for agent instructions. Keeping CLAUDE.md out of the
# repo prevents a second source of truth from drifting away from AGENTS.md.
CLAUDE.md

# =============================================================
# OS
# =============================================================
.DS_Store

# =============================================================
# Elixir / Phoenix
# =============================================================
# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
rolezinho-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Elixir language server artifacts.
/.elixir_ls/

# Local event data (markdown dropped in by hand, not part of the app).
priv/data/*.md

# =============================================================
# Secrets
# -------------------------------------------------------------
# Local secrets: API keys and credentials never enter the repository.
# The expected variables are documented in README.md.
# =============================================================
.env
.env.*
!.env.example
