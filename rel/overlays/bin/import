#!/bin/sh
# One-shot importer for rolezinho markdown files.
#
# Reads .md files from a directory and inserts them as events in the
# database, mapping `hidden/` and `done/` subdirectories to the matching
# status. Existing slugs are skipped unless --overwrite is passed.
#
# Usage: bin/import [--data-path PATH] [--overwrite] [--dry-run]
#
# When DATA_PATH is unset and --data-path is not passed, this exits with an
# error since the release doesn't know a sensible default.

set -eu

usage() {
  cat <<EOF
Usage: $(basename "$0") [--data-path PATH] [--overwrite] [--dry-run]

Options:
  --data-path PATH   Base directory of .md files (or set \$DATA_PATH).
  --overwrite        Overwrite existing rows with the same slug.
  --dry-run          Parse files but do not touch the database.
  -h, --help         Show this help.
EOF
}

IMPORT_OVERWRITE="${IMPORT_OVERWRITE:-false}"
IMPORT_DRY_RUN="${IMPORT_DRY_RUN:-false}"

while [ $# -gt 0 ]; do
  case "$1" in
    --data-path)
      shift
      [ $# -gt 0 ] || { echo "--data-path requires an argument" >&2; exit 1; }
      DATA_PATH="$1"
      shift
      ;;
    --overwrite)
      IMPORT_OVERWRITE="true"
      shift
      ;;
    --dry-run)
      IMPORT_DRY_RUN="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [ -z "${DATA_PATH:-}" ]; then
  echo "DATA_PATH is not set. Pass --data-path PATH or set the DATA_PATH env var." >&2
  exit 1
fi

export DATA_PATH IMPORT_OVERWRITE IMPORT_DRY_RUN

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"

exec "$script_dir/rolezinho" eval 'Rolezinho.Release.import()'
